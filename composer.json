{
    "name": "le0daniel/assertions",
    "description": "PHPstan compatible assertions similar to zod",
    "type": "library",
    "require": {
        "php": "^8.5"
    },
    "scripts": {
        "check:types": "phpstan --memory-limit=1G analyse src",
        "check:tests": "phpunit",
        "check:all": [
            "@check:types",
            "@check:tests"
        ]
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpspec/prophecy": "^1.25"
    },
    "autoload": {
        "psr-4": {
            "Le0daniel\\Assertions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Le0daniel\\Assertions\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Leo Studer"
        }
    ]
}
